# Copy values into your local shell or an ignored .env file; Django does not load this file.
# All values below are fake. Never use them for staging or production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-fake-secret-change-before-use-0123456789abcdef
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://orca_dev:FAKE_PASSWORD@localhost:5432/orca_dev?sslmode=disable
DATABASE_CONNECTION_MODE=local
DB_CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=false
LOG_LEVEL=INFO
PAYMENTS_LIVE_ENABLED=false
SMS_BACKEND=console
